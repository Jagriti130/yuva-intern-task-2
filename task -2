ax.set_ylabel("Sex")
save(fig, "07_survival_heatmap_sex_class")

# Figure 8: age distribution by survival outcome
fig, ax = plt.subplots(figsize=(10, 5.5))
sns.kdeplot(data=df, x="Age", hue="SurvivedLabel", fill=True, common_norm=False,
