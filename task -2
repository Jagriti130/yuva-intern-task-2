"""
eda_titanic.py
Week 2 - Exploratory Data Analysis and Visualization
Dataset : Titanic passenger data (Kaggle train.csv, 891 rows, 12 columns)
Input   : raw/train.csv
Outputs : figures/*.png, tables/*.csv, console summary
Libraries: pandas, numpy, matplotlib, seaborn, scipy
"""

from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats

# ----------------------------------------------------------------------
# 0. Configuration
# ----------------------------------------------------------------------
DATA_PATH = Path("raw/train.csv")
FIG_DIR = Path("figures")
TAB_DIR = Path("tables")
FIG_DIR.mkdir(exist_ok=True)
TAB_DIR.mkdir(exist_ok=True)

sns.set_theme(style="whitegrid", context="talk", palette="deep")
plt.rcParams["figure.dpi"] = 110
SAVE_KW = dict(dpi=150, bbox_inches="tight")

SURVIVAL_LABELS = {0: "Did not survive", 1: "Survived"}


def save(fig, name):
    """Save a figure to figures/ and close it to free memory."""
    path = FIG_DIR / f"{name}.png"
    fig.savefig(path, **SAVE_KW)
    plt.close(fig)
    print(f"  saved -> {path}")


def section(title):
    print("\n" + "=" * 72)
    print(title)
    print("=" * 72)


# ----------------------------------------------------------------------
# 1. Load and prepare for analysis
# ----------------------------------------------------------------------
section("1. LOAD DATA")
df = pd.read_csv(DATA_PATH)
print("Shape:", df.shape)

# Light preparation needed only for EDA (full cleaning is in the Week 1 pipeline)
df["Sex"] = df["Sex"].str.capitalize()
df["Title"] = df["Name"].str.extract(r",\s*([^\.]+)\.", expand=False).str.strip()
df["Title"] = df["Title"].replace({"Mlle": "Miss", "Ms": "Miss", "Mme": "Mrs"})
rare = ["Capt", "Col", "Countess", "Don", "Dona", "Dr", "Jonkheer",
        "Lady", "Major", "Rev", "Sir"]
df["Title"] = df["Title"].where(~df["Title"].isin(rare), "Rare")
df["FamilySize"] = df["SibSp"] + df["Parch"] + 1
df["IsAlone"] = (df["FamilySize"] == 1).map({True: "Alone", False: "With family"})
df["Deck"] = df["Cabin"].str[0].fillna("Unknown")
df["SurvivedLabel"] = df["Survived"].map(SURVIVAL_LABELS)
df["Pclass_label"] = df["Pclass"].map({1: "1st", 2: "2nd", 3: "3rd"})
df["AgeGroup"] = pd.cut(
    df["Age"], bins=[0, 12, 18, 35, 60, 100],
    labels=["Child (0-12)", "Teen (13-18)", "Young adult (19-35)",
            "Adult (36-60)", "Senior (60+)"], right=True,
)

# ----------------------------------------------------------------------
# 2. Initial analysis: structure, types, basic statistics, missingness
# ----------------------------------------------------------------------
section("2. INITIAL ANALYSIS")
print(df.dtypes)
print("\nFirst rows:\n", df.head())

numeric_cols = ["Age", "SibSp", "Parch", "Fare", "FamilySize"]
desc = df[numeric_cols].describe().T
desc["skew"] = df[numeric_cols].skew()
desc["missing"] = df[numeric_cols].isna().sum()
print("\nDescriptive statistics:\n", desc.round(2))
desc.round(3).to_csv(TAB_DIR / "numeric_summary.csv")

cat_cols = ["Survived", "Pclass", "Sex", "Embarked", "Title", "Deck"]
for c in cat_cols:
    print(f"\n{c} value counts:\n", df[c].value_counts(dropna=False))

missing = df.isna().sum()
missing = missing[missing > 0].sort_values(ascending=False)
missing_pct = (missing / len(df) * 100).round(1)
print("\nMissing values:\n", pd.DataFrame({"count": missing, "pct": missing_pct}))

overall_survival = df["Survived"].mean()
print(f"\nOverall survival rate: {overall_survival:.1%}")

# Figure 1: missingness bar chart
fig, ax = plt.subplots(figsize=(9, 4.5))
bars = ax.barh(missing.index, missing_pct.values, color=sns.color_palette("deep")[3])
ax.bar_label(bars, fmt="%.1f%%", padding=4)
ax.set_title("Percentage of Missing Values by Column")
ax.set_xlabel("Missing (%)")
ax.set_ylabel("Column")
ax.set_xlim(0, missing_pct.max() * 1.15)
save(fig, "01_missing_values")

