# ----------------------------------------------------------------------
# 6. Anomaly and outlier detection
# ----------------------------------------------------------------------
section("6. ANOMALIES AND OUTLIERS")


def iqr_flags(s, k=1.5):
    q1, q3 = s.quantile([0.25, 0.75])
    iqr = q3 - q1
    lo, hi = q1 - k * iqr, q3 + k * iqr
    return (s < lo) | (s > hi), lo, hi


fare_flag, f_lo, f_hi = iqr_flags(df["Fare"].dropna())
age_flag, a_lo, a_hi = iqr_flags(df["Age"].dropna())
print(f"Fare IQR bounds: [{f_lo:.2f}, {f_hi:.2f}], flagged {fare_flag.sum()}")
print(f"Age  IQR bounds: [{a_lo:.2f}, {a_hi:.2f}], flagged {age_flag.sum()}")

fare_outliers = df.loc[fare_flag.reindex(df.index, fill_value=False)]
print("\nFare outliers by class:\n", fare_outliers["Pclass_label"].value_counts())
print("\nZero-fare passengers:", (df["Fare"] == 0).sum())
print("\nTop 5 fares:\n",
      df.nlargest(5, "Fare")[["PassengerId", "Pclass", "Fare", "Cabin", "Survived"]])

# Figure 13: anomaly summary - count of IQR outliers per class
out_by_class = (fare_outliers["Pclass_label"].value_counts()
                .reindex(["1st", "2nd", "3rd"], fill_value=0))
fig, ax = plt.subplots(figsize=(8, 5))
bars = ax.bar(out_by_class.index, out_by_class.values, color=["#4c72b0", "#dd8452", "#55a868"])
ax.bar_label(bars, padding=3)
ax.set_title("IQR Fare Outliers by Ticket Class")
ax.set_xlabel("Ticket class")
ax.set_ylabel("Number of flagged passengers")
save(fig, "13_fare_outliers_by_class")

