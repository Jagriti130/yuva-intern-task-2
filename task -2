section("7. AGGREGATIONS")
agg_table = (df.groupby(["Pclass_label", "Sex"], observed=True)
               .agg(passengers=("PassengerId", "size"),
                    survivors=("Survived", "sum"),
                    survival_rate=("Survived", "mean"),
