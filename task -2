               .round(3).reset_index())
print(agg_table)
agg_table.to_csv(TAB_DIR / "aggregate_class_sex.csv", index=False)

# ----------------------------------------------------------------------
# 8. Statistical checks on the visual patterns
# ----------------------------------------------------------------------
section("8. STATISTICAL CHECKS")
ct_sex = pd.crosstab(df["Sex"], df["Survived"])
chi2, p, dof, _ = stats.chi2_contingency(ct_sex)
print(f"Sex vs survival: chi2={chi2:.2f}, dof={dof}, p={p:.2e}")

ct_class = pd.crosstab(df["Pclass"], df["Survived"])
chi2, p, dof, _ = stats.chi2_contingency(ct_class)
print(f"Class vs survival: chi2={chi2:.2f}, dof={dof}, p={p:.2e}")

fare_surv = df.loc[df["Survived"] == 1, "Fare"].dropna()
fare_dead = df.loc[df["Survived"] == 0, "Fare"].dropna()
u, p = stats.mannwhitneyu(fare_surv, fare_dead, alternative="two-sided")
print(f"Fare, survivors vs non-survivors (Mann-Whitney U): U={u:.0f}, p={p:.2e}")

