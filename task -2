# ----------------------------------------------------------------------
# 4. Bivariate analysis: relationships with survival
# ----------------------------------------------------------------------
section("4. BIVARIATE ANALYSIS: SURVIVAL RATES")


def survival_rate(by):
    """Survival rate and group size for a categorical column."""
    out = (df.groupby(by, observed=True)["Survived"]
             .agg(survival_rate="mean", passengers="size")
             .reset_index())
    out["survival_rate"] = out["survival_rate"].round(3)
    return out


rate_sex = survival_rate("Sex")
rate_class = survival_rate("Pclass_label")
rate_embark = survival_rate("Embarked")
rate_family = survival_rate("IsAlone")
for name, t in [("sex", rate_sex), ("class", rate_class),
                ("embarked", rate_embark), ("family", rate_family)]:
    print(f"\nSurvival rate by {name}:\n", t)
    t.to_csv(TAB_DIR / f"survival_by_{name}.csv", index=False)

# Figure 6: survival rate by sex and class (grouped bars with annotations)
fig, ax = plt.subplots(figsize=(10, 6))
sns.barplot(data=df, x="Pclass_label", y="Survived", hue="Sex",
            order=["1st", "2nd", "3rd"], errorbar=("ci", 95),
            palette={"Female": "#d62728", "Male": "#1f77b4"}, ax=ax)
ax.axhline(overall_survival, color="grey", ls="--", label=f"Overall = {overall_survival:.0%}")
ax.set_title("Survival Rate by Ticket Class and Sex (95% CI)")
ax.set_xlabel("Ticket class")
ax.set_ylabel("Survival rate")
ax.set_ylim(0, 1)
ax.yaxis.set_major_formatter(plt.matplotlib.ticker.PercentFormatter(1.0))
ax.legend(title="Sex", loc="upper right")
save(fig, "06_survival_by_class_and_sex")

# Figure 7: heatmap of survival rate across class and sex, with counts
pivot_rate = df.pivot_table(index="Sex", columns="Pclass_label",
                            values="Survived", aggfunc="mean")
pivot_rate = pivot_rate[["1st", "2nd", "3rd"]]
pivot_n = df.pivot_table(index="Sex", columns="Pclass_label",
                         values="Survived", aggfunc="size")[["1st", "2nd", "3rd"]]
annot = pivot_rate.map(lambda v: f"{v:.0%}") + "\n(n=" + pivot_n.astype(str) + ")"
fig, ax = plt.subplots(figsize=(8, 4.5))
sns.heatmap(pivot_rate, annot=annot, fmt="", cmap="RdYlGn", vmin=0, vmax=1,
            cbar_kws={"label": "Survival rate"}, linewidths=1, ax=ax)
ax.set_title("Survival Rate Heatmap: Sex x Ticket Class")
